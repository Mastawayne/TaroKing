<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<RootNamespace>TaroKing.App</RootNamespace>
		<AssemblyName>TaroKing.App</AssemblyName>
		<UserSecretsId>taroking-app</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\TaroKing.Engine\TaroKing.Engine.csproj" />
		<ProjectReference Include="..\TaroKing.Bots\TaroKing.Bots.csproj" />
		<ProjectReference Include="..\TaroKing.Data\TaroKing.Data.csproj" />
	</ItemGroup>

	<!--
		The EF tools want the Design package on the *startup* project when generating migrations
		(`dotnet ef migrations add ... -startup-project src\TaroKing.App`). Design-time only.
	-->
	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<!-- The word list travels with the app; keys and backups are written next to it at run time. -->
	<ItemGroup>
		<None Update="App_Data\badwords.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
