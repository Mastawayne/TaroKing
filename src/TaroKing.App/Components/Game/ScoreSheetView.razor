@using TaroKing.App.Services
@using TaroKing.Engine
@using TaroKing.Engine.Bidding
@using TaroKing.Engine.Scoring

@*
	The running sheet. Radlci are shown as the little wheels they are drawn as on paper: while you
	carry one, the game you declare counts double, and whatever is left at the end costs 100 each.
*@

<section class="sheet">
	<h2>Štrafta</h2>

	<table>
		<thead>
			<tr>
				<th>#</th>
				<th>igra</th>
				@for (int seat = 0; seat < TarokConstants.PlayerCount; seat++) {
					<th class="@(seat == YouSeat ? "you" : null)">@NameOf(seat)</th>
				}
			</tr>
		</thead>

		<tbody>
			@if (Records.Count == 0) {
				<tr class="empty">
					<td colspan="@(TarokConstants.PlayerCount + 2)">Še nobene odigrane partije.</td>
				</tr>
			}

			@foreach (HandRecord record in Records) {
				<tr>
					<td class="muted">@record.Number</td>
					<td class="muted" title="@NameOf(record.Declarer)">@Contracts.Info(record.Contract).SlovenianName</td>
					@for (int seat = 0; seat < TarokConstants.PlayerCount; seat++) {
						<td class="@Sign(record.Scores[seat])">@Signed(record.Scores[seat])</td>
					}
				</tr>
			}
		</tbody>

		<tfoot>
			<tr class="totals">
				<td colspan="2">skupaj</td>
				@for (int seat = 0; seat < TarokConstants.PlayerCount; seat++) {
					<td class="@Sign(Sheet.Totals[seat])">@Signed(Sheet.Totals[seat])</td>
				}
			</tr>
			<tr class="radlci">
				<td colspan="2">radlci</td>
				@for (int seat = 0; seat < TarokConstants.PlayerCount; seat++) {
					<td title="@(Sheet.Radlci[seat]) radlc(ev)">@Wheels(Sheet.Radlci[seat])</td>
				}
			</tr>
			<tr class="final">
				<td colspan="2">z radlci</td>
				@foreach (int total in Sheet.FinalTotals()) {
					<td class="@Sign(total)">@Signed(total)</td>
				}
			</tr>
		</tfoot>
	</table>
</section>

@code {

	[Parameter, EditorRequired]
	public IReadOnlyList<HandRecord> Records { get; set; } = [];

	[Parameter, EditorRequired]
	public ScoreSheet Sheet { get; set; } = default!;

	[Parameter, EditorRequired]
	public Func<int, string> NameOf { get; set; } = default!;

	/// <summary>The column to pick out as the reader's own, if they have one.</summary>
	[Parameter]
	public int? YouSeat { get; set; }

	private static string Signed(int value) =>
		value.ToString("+#;-#;0", System.Globalization.CultureInfo.InvariantCulture);

	private static string? Sign(int value) => value switch {
		> 0 => "plus",
		< 0 => "minus",
		_ => null
	};

	private static string Wheels(int count) => count == 0 ? "—" : string.Concat(Enumerable.Repeat("◯", count));
}
