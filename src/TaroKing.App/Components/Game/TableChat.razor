@using TaroKing.App.Services

@*
	Table talk — the lines and the box to type in; the board wraps it in its panel. The table
	itself speaks here too (who sat down, whose clock ran out, how a hand ended), so the log doubles
	as the table's own record of what happened.
*@

<ol>
	@foreach (ChatLine line in Lines) {
		<li class="@(line.FromTable ? "from-table" : null)">
			@if (!line.FromTable) {
				<b>@line.Who</b>
			}
			<span>@line.Text</span>
		</li>
	}
</ol>

<form @onsubmit="Send" @onsubmit:preventDefault>
	<label class="visually-hidden" for="chat-text">Sporočilo</label>
	<input id="chat-text" class="field" @bind="_text" @bind:event="oninput" maxlength="200" placeholder="Napiši kaj …" autocomplete="off" />
	<button type="submit" class="btn" disabled="@(string.IsNullOrWhiteSpace(_text))">Pošlji</button>
</form>

@code {

	private string _text = "";

	[Parameter, EditorRequired]
	public IReadOnlyList<ChatLine> Lines { get; set; } = [];

	[Parameter]
	public EventCallback<string> OnSay { get; set; }

	private async Task Send() {
		if (string.IsNullOrWhiteSpace(_text)) {
			return;
		}

		string said = _text;
		_text = "";

		await OnSay.InvokeAsync(said);
	}
}
