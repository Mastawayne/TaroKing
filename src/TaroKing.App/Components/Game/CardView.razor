@using TaroKing.Engine.Cards

@*
	One card. A button whenever it can be clicked and a plain div otherwise, so the keyboard reaches
	exactly the cards that are in play. "Dimmed" is a hint, never a rule: the server decides.

	Plain suits: cream card, the rank in the corner, one big pip. Trumps: dark card, the numeral in
	gold, a small T in the corner (which carries the numeral too, for layouts that hide the big one).
*@

@if (Clickable) {
	<button type="button"
			class="@CssClass"
			title="@Title"
			aria-label="@Title"
			@onclick="Clicked">
		@Face
	</button>
} else {
	<div class="@CssClass" title="@Title">
		@Face
	</div>
}

@code {

	public enum CardSize { Hand, Trick, Small }

	[Parameter, EditorRequired]
	public Card Card { get; set; }

	/// <summary>The engine says this card may be played right now.</summary>
	[Parameter]
	public bool Legal { get; set; } = true;

	/// <summary>Picked out — a selected discard, or the card that took the trick.</summary>
	[Parameter]
	public bool Selected { get; set; }

	[Parameter]
	public CardSize Size { get; set; } = CardSize.Hand;

	[Parameter]
	public EventCallback<Card> OnSelect { get; set; }

	private bool Clickable => OnSelect.HasDelegate && Legal;

	private Task Clicked() => OnSelect.InvokeAsync(Card);

	private string CssClass {
		get {
			List<string> classes = ["card", $"suit-{Card.Suit.ToString().ToLowerInvariant()}"];

			if (Size == CardSize.Trick) {
				classes.Add("card-trick");
			} else if (Size == CardSize.Small) {
				classes.Add("card-small");
			}

			if (Selected) {
				classes.Add("card-selected");
			}

			if (OnSelect.HasDelegate && !Legal) {
				classes.Add("card-dimmed");
			}

			if (Clickable) {
				classes.Add("card-playable");
			}

			return string.Join(' ', classes);
		}
	}

	private string Title => Card.IsTrump
		? $"{Card.ShortName} — tarok, {Card.Points} t."
		: $"{Card.ShortName} — {Card.Suit.SlovenianName()}, {Card.Points} t.";

	private RenderFragment Face => builder => {
		builder.OpenElement(0, "span");
		builder.AddAttribute(1, "class", "card-corner");
		if (Card.IsTrump) {
			builder.AddAttribute(2, "data-r", Card.ShortName);
		}
		builder.AddContent(3, Card.IsTrump ? "T" : RankSymbol);
		builder.CloseElement();

		builder.OpenElement(4, "span");
		builder.AddAttribute(5, "class", Card.IsTrump ? "card-figure card-figure-trump" : "card-figure");
		builder.AddContent(6, Card.IsTrump ? Card.ShortName : Card.Suit.Symbol());
		builder.CloseElement();
	};

	/// <summary>Court cards in Slovenian: kralj, dama, kavalj, pob. Pips keep their number.</summary>
	private string RankSymbol => (SuitRank)Card.Rank switch {
		SuitRank.King => "K",
		SuitRank.Queen => "D",
		SuitRank.Knight => "C",
		SuitRank.Jack => "P",
		_ => Card.ShortName[..^1]
	};
}
