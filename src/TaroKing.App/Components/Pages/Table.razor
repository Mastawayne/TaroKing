@page "/miza"
@page "/miza/{SessionId}"
@layout TableLayout

@using TaroKing.App.Components.Game
@using TaroKing.App.Services
@using TaroKing.Engine.Cards
@using TaroKing.Engine.Scoring
@using TaroKing.Engine.Session

@implements IDisposable

@inject LocalGames Games
@inject PlayerSession Me
@inject NavigationManager Navigation

<PageTitle>TaroKing — miza</PageTitle>

@*
	A session against bots. The game itself lives in LocalGames, not in this circuit, so a refresh
	lands back on the same hand — the id in the address bar is the whole of the bookmark.
*@

<h1 class="visually-hidden">Miza</h1>

@if (_missing) {

	<main class="plain"><div class="page">
		<section class="card-panel intro">
			<h2>Te igre ni več</h2>
			<p class="lead">Miza je bila predolgo prazna in smo jo pospravili. Nova je en klik stran.</p>
			<a class="btn" href="/nova-igra">Nova igra</a>
		</section>
	</div></main>

} else if (_game is not LocalGame game) {

	<main class="plain"><div class="page"><p class="hint">Pripravljamo mizo …</p></div></main>

} else if (game.IsOver) {

	<main class="plain"><div class="page">
		<SessionSummary Stats="game.Stats()" YouSeat="game.Seat" OnPlayAgain="PlayAgain" />

		@if (game.View is PlayerView last && last.Score is not null) {
			<section class="card-panel">
				<h2>Zadnja partija</h2>
				<ul class="score-lines">
					@foreach (ScoreLine line in last.Score.Lines) {
						<li>@line.ToString()</li>
					}
				</ul>
			</section>
		}

		<section class="card-panel sheet plain">
			<h2>Zapisnik</h2>
			<ScoreSheetView Records="game.Records" Sheet="game.Sheet" NameOf="game.NameOf" YouSeat="game.Seat" />
		</section>
	</div></main>

} else if (game.View is PlayerView view) {

	<Board View="view"
		   NameOf="game.NameOf"
		   Busy="game.BotsAreThinking"
		   Radlc="game.Hand?.RadlcMultiplier > 1"
		   Pick="_pick"
		   OnPlay="PlayAsync">
		<Chips>
			<span class="chip">@Progress(game)</span>
		</Chips>
		<Actions>
			<ActionPanel Actions="game" View="view" Pick="_pick" />
		</Actions>
		<Sheet>
			<ScoreSheetView Records="game.Records" Sheet="game.Sheet" NameOf="game.NameOf" YouSeat="game.Seat" />
		</Sheet>
	</Board>

} else {

	<main class="plain"><div class="page"><p class="hint">Delimo …</p></div></main>
}

@code {

	private readonly DiscardPick _pick = new();
	private LocalGame? _game;
	private bool _missing;
	private bool _needsKick;

	[Parameter]
	public string? SessionId { get; set; }

	protected override void OnParametersSet() {
		if (_game is not null && _game.Id == SessionId) {
			return;
		}

		Detach();

		// Somebody walked in through /miza without an id: a quick game is made once we know who
		// they are, which needs the page to be interactive. OnAfterRenderAsync picks it up.
		if (string.IsNullOrWhiteSpace(SessionId)) {
			_needsKick = true;

			return;
		}

		_game = Games.Find(SessionId);
		_missing = _game is null;

		if (_game is not null) {
			_game.Changed += Redraw;
			_needsKick = true;
		}
	}

	/// <summary>
	/// Deal or pick the hand back up, but only once the page is really interactive — a prerender
	/// must not sit and wait for three bots to think.
	/// </summary>
	protected override async Task OnAfterRenderAsync(bool firstRender) {
		if (!_needsKick) {
			return;
		}

		_needsKick = false;

		if (_game is not LocalGame game) {
			if (string.IsNullOrWhiteSpace(SessionId)) {
				PlayerIdentity me = await Me.ResolveAsync();
				LocalGame fresh = Games.Create(new SessionOptions(), me);
				Navigation.NavigateTo($"/miza/{fresh.Id}", replace: true);
			}

			return;
		}

		if (game.Hand is null && !game.IsOver) {
			await game.DealAsync();
		} else {
			await game.ResumeAsync();
		}
	}

	public void Dispose() => Detach();

	private void Detach() {
		if (_game is not null) {
			_game.Changed -= Redraw;
			_game = null;
		}

		_missing = false;
		_needsKick = false;
	}

	private void Redraw() => InvokeAsync(StateHasChanged);

	private void PlayAgain() {
		if (_game is not LocalGame game) {
			return;
		}

		LocalGame again = Games.Create(game.Options with { IsReplay = false }, game.Owner);
		Navigation.NavigateTo($"/miza/{again.Id}");
	}

	private static string Progress(LocalGame game) => game.Options.Mode switch {
		SessionMode.Hands => $"Partija {Math.Max(game.HandNumber, 1)} / {game.Options.HandCount}",
		SessionMode.Target => $"{game.Sheet.Totals.Max()} / {game.Options.TargetScore} točk",
		_ => $"Partija {Math.Max(game.HandNumber, 1)}"
	};

	private Task PlayAsync(Card card) => _game?.PlayCardAsync(card) ?? Task.CompletedTask;
}
