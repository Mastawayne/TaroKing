@page "/"

<PageTitle>TaroKing</PageTitle>

<div class="hero"><BrandLogo /><h1>TaroKing</h1></div>

@if (Sporocilo == "izbrisano") {
	<p class="notice notice-ok">Račun je izbrisan. Hvala za igro — kot gost si vedno dobrodošel nazaj.</p>
}

<p class="lead">
	Slovenski tarok. Motor, boti in miza so zgrajeni po fazah iz <code>Tasks.md</code> —
	igra proti botom teče, spletne mize pridejo naslednje.
</p>

<section class="card-panel">
	<h2>Zaigraj</h2>
	<p>Seja proti trem botom s polnimi pravili: licitacija, talon, napovedi, kontre in zapisnik.</p>
	<div class="button-row">
		<a class="btn" href="/nova-igra">Nova igra</a>
		<a class="btn btn-quiet" href="/miza">Hitra partija</a>
	</div>
</section>

<section class="card-panel">
	<h2>Z ljudmi</h2>
	<p>Odpri spletno mizo ali sedi za tujo. Prazna mesta lahko igrajo boti, dokler ne pride kdo.</p>
	<div class="button-row">
		<a class="btn" href="/lobi">V lobi</a>
		<a class="btn btn-quiet" href="/lestvica">Lestvica</a>
	</div>
</section>

<section class="card-panel">
	<h2>Račun</h2>
	<p>Brez računa igraš kot gost. Z računom se partije shranjujejo, rating se premika in vidiš svojo zgodovino.</p>
	<div class="button-row">
		<a class="btn btn-quiet" href="/prijava">Prijava</a>
		<a class="btn btn-quiet" href="/registracija">Registracija</a>
		<a class="btn btn-quiet" href="/zgodovina">Zgodovina</a>
	</div>
</section>

<section class="card-panel">
	<h2>Pravila na kratko</h2>
	<ul>
		<li>Igralcev za mizo: @TarokConstants.PlayerCount</li>
		<li>Kart v špilu: @TarokConstants.DeckSize (od tega @TarokConstants.TrumpCount tarokov)</li>
		<li>Za zmago: @TarokConstants.WinningCardPoints od @TarokConstants.TotalCardPoints točk</li>
		<li>Nepobrisan radlc na koncu stane @TarokConstants.UncancelledRadlcPenalty točk</li>
	</ul>
</section>

@code {

	[SupplyParameterFromQuery(Name = "sporocilo")]
	public string? Sporocilo { get; set; }
}
