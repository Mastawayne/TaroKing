@inherits LayoutComponentBase

@*
	The table pages: the bar on top and the felt filling everything that is left. Nothing scrolls
	on a desktop — the hand is always at the bottom of the window, the way a real table does not move.
*@

<div class="app app-table">
	<TopBar />
	@Body
</div>

<div id="blazor-error-ui">
	Prišlo je do nepričakovane napake.
	<a href="" class="reload">Osveži</a>
	<span class="dismiss">🗙</span>
</div>
